      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ何も取り込まれていません"
          }
        }
      }
    },
    "Paused": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止中"
          }
        }
      }
    },
    "Paused. New prompts are not captured.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止中です。新しいプロンプトは取り込まれません。"
          }
        }
      }
    },
    "Press ⌘D to keep a phrase worth remembering.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "覚えておきたい言い回しは ⌘D で残せます。"
          }
        }
      }
    },

    "Unread": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未読"
          }
        }
      }
    },
    "Uses your own claude CLI (claude -p --model …). Set MACHIAI_TRANSLATE_CMD in config.env to use another translator.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの claude CLI（claude -p --model …）で翻訳します。別の翻訳手段を使うには config.env で MACHIAI_TRANSLATE_CMD を設定してください。"
          }
        }
      }
    },
    "·": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "·"
          }
        }
      }

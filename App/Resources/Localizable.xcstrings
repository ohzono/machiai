      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳中… %lld 秒"
          }
        }
      }
    },
    "Translation": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳"
          }
        }
      }
    },
    "Translation failed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳に失敗しました"

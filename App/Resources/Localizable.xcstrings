      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読む"
          }
        }
      }
    },
    "Reinstall Hook": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",

{
  "sourceLanguage": "en",
  "strings": {
    "%lld pt": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld pt"
          }
        }
      }
    },
    "Add to Favorites": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りに追加"
          }
        }
      }
    },
    "Adds one UserPromptSubmit hook to ~/.claude/settings.json (a backup is kept). New Claude Code sessions pick it up. Or run this in a terminal:": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.claude/settings.json に UserPromptSubmit hook を1つ追加します（バックアップを残します）。新しく開いた Claude Code のセッションから有効になります。ターミナルで次のコマンドを実行しても同じです:"
          }
        }
      }
    },
    "All": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて"
          }
        }
      }
    },
    "All caught up": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて読みました"
          }
        }
      }
    },
    "Bigger Text": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字を大きく"
          }
        }
      }
    },
    "Capture Prompts": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロンプトを取り込む"
          }
        }
      }
    },
    "Capture prompts": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロンプトを取り込む"
          }
        }
      }
    },
    "Capturing": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り込み中"
          }
        }
      }
    },
    "Capturing new prompts. Click to pause.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいプロンプトを取り込んでいます。クリックで一時停止します。"
          }
        }
      }
    },
    "Claude Code": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code"
          }
        }
      }
    },
    "Copy Translation": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "訳文をコピー"
          }
        }
      }
    },
    "Copy Translation (⇧⌘C)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "訳文をコピー（⇧⌘C）"
          }
        }
      }
    },
    "Default Text Size": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "標準の文字サイズ"
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除"
          }
        }
      }
    },
    "Entry": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エントリ"
          }
        }
      }
    },
    "Favorite": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入り"
          }
        }
      }
    },
    "Favorite (⌘D)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入り（⌘D）"
          }
        }
      }
    },
    "Favorites": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入り"
          }
        }
      }
    },
    "Hide Machiai when everything is read": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて読んだら Machiai を隠す"
          }
        }
      }
    },
    "Install for Claude Code": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code にインストール"
          }
        }
      }
    },
    "Installed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済み"
          }
        }
      }
    },
    "Learn English while your agent thinks": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待ち時間を、英語の時間に"
          }
        }
      }
    },
    "Machiai translates each prompt you type to Claude Code into natural English, in the background. Switch here with ⌘Tab, read how you would have said it, check it off, and go back to work.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code に打ったプロンプトを、Machiai が裏で自然な英語に訳します。⌘Tab で切り替えて「英語ならこう言う」を読み、チェックを付けたら作業に戻りましょう。"
          }
        }
      }
    },
    "Mark as Read": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既読にする"
          }
        }
      }
    },
    "Mark as Read (⌘↩)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既読にする（⌘↩）"
          }
        }
      }
    },
    "Mark as Unread": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未読に戻す"
          }
        }
      }
    },
    "Model": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデル"
          }
        }
      }
    },
    "New translations appear here while your agent is thinking.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが考えている間に、新しい訳がここに届きます。"
          }
        }
      }
    },
    "No favorites yet": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りはまだありません"
          }
        }
      }
    },
    "No unread entries": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未読はありません"
